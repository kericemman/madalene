NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/earned-credibility

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
CORS_ORIGINS=http://localhost:5173

ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ROLE=admin

RESEND_API_KEY=
EMAIL_FROM=Magdalene Wambui <hello@example.com>
EMAIL_LOGO_URL=
ADMIN_NOTIFICATION_EMAIL=
ONE_TO_ONE_BOOKING_URL=https://calendly.com/wambui-magdalene/content-that-connects

# OpenAI scores the five written evidence responses against the fixed 1-5 assessment rubric.
# The backend validates every category score and calculates the final /25 result. Keep disabled until configured.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ASSESSMENT_ANALYSIS_ENABLED=false
OPENAI_ASSESSMENT_MIN_CONFIDENCE=0.65

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DEFAULT_FOLDER=earned-credibility
MAX_UPLOAD_MB=10

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

APP_URL=http://localhost:5173
API_URL=http://localhost:5000/api
RESULT_TOKEN_SECRET=replace-with-result-token-secret
CRON_SECRET=replace-with-cron-secret
ENABLE_EMAIL_WORKER=false
EMAIL_WORKER_INTERVAL_MS=60000
